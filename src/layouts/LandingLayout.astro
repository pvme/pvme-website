---
import Layout from './Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
interface Props {
  title: string;
  heading?: string;
  description: string;
  activePath?: string;
  pageClass?: string;
  pageAttributes?: Record<string, string | boolean>;
}
const {
  title,
  heading = title,
  description,
  activePath,
  pageClass,
  pageAttributes = {},
} = Astro.props;
---

<Layout
  title={title}
  description={description}
  activePath={activePath}
  breadcrumbs={[{ label: title }]}
>
  <div
    class:list={['page', 'directory-page', 'landing-page', pageClass]}
    {...pageAttributes}
  >
    <Breadcrumbs items={[{ label: title }]} />
    <header class="page-heading landing-hero">
      <h1>{heading}</h1>
      <p>{description}</p>
    </header>
    <slot />
  </div>
</Layout>
