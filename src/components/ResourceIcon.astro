---
import Icon from './Icon.astro';
import { url } from '../lib/catalogue';
const { name, size = 42 } = Astro.props as { name: string; size?: number };
const paths: Record<string, string> = {
  rocket:
    'M14 5c3-3 7-3 7-3s0 4-3 7l-7 7-5-5 8-6ZM6 11H2l4-5h7 M11 16v6l5-5v-5 M5 15c-3 1-3 6-3 6s5 0 6-3 M15 7a2 2 0 1 0 4 0 2 2 0 0 0-4 0',
  bolt: 'M14 2 4 14h7l-1 8 10-13h-7l1-7Z',
  document: 'M5 2h9l5 5v15H5V2Zm9 0v6h5 M8 11h8 M8 15h8 M8 18h6',
};
---

{name === 'invention' ? (
  <img
    src={url('/icons/invention.png')}
    width={size}
    height={size}
    alt=""
    aria-hidden="true"
    decoding="async"
  />
) : name.includes('+') ? (
  <span class="resource-combat-icons" aria-hidden="true">
    {name.split('+').map((style) => (
      <Icon name={style} size={Math.round(size / 2)} />
    ))}
  </span>
) : name === 'chart' ? (
  <svg
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="currentColor"
    aria-hidden="true"
  >
    <rect x="2" y="17" width="3.7" height="6" rx="1" />
    <rect x="7.5" y="12" width="3.7" height="11" rx="1" />
    <rect x="13" y="7" width="3.7" height="16" rx="1" />
    <rect x="18.5" y="2" width="3.7" height="21" rx="1" />
  </svg>
) : paths[name] ? (
  <svg
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d={paths[name]} />
  </svg>
) : (
  <Icon name={name} size={size} />
)}

<style>
  .resource-combat-icons {
    display: inline-flex;
    align-items: center;
    gap: 2px;
  }
</style>
