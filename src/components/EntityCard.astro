---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getCatalogue, url, type Hub } from '../lib/catalogue';
import { getRendered } from '../lib/renderer';
import { findHeaderArtwork } from '../lib/header-artwork';
import Icon from './Icon.astro';
const { hub } = Astro.props as { hub: Hub };
const artwork = import.meta.glob<ImageMetadata>(
  '../assets/{bosses,slayer}/*.{webp,avif,png,jpg,jpeg}',
  { eager: true, import: 'default' },
);
const kind = hub.href.startsWith('/slayer/') ? 'slayer' : 'bosses';
const localArtwork = findHeaderArtwork(artwork, kind, hub.slug);
const root = getCatalogue().root;
const image = [...hub.guides]
  .sort(
    (a, b) =>
      Number(b.types.includes('boss-overview')) -
      Number(a.types.includes('boss-overview')),
  )
  .map((g) => getRendered(g, root).image)
  .find(Boolean);
---

<a class="entity-card" href={url(hub.href)}>
  {localArtwork || image ? (
    <span class="entity-art">
      {localArtwork ? (
        <Image
          src={localArtwork}
          alt=""
          width={480}
          format="webp"
          quality={85}
          loading="lazy"
          decoding="async"
        />
      ) : (
        <img src={image} alt="" loading="lazy" decoding="async" />
      )}
    </span>
  ) : (
    <span class="entity-placeholder" aria-hidden="true">
      ◇
    </span>
  )}
  <div>
    <h3>{hub.name}</h3>
  </div>
  <Icon name="arrow" size={26} />
</a>
