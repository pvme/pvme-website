---
import type { Guide } from '../lib/catalogue';
import { guideEditorHref } from '../lib/guide-editor';
import Icon from './Icon.astro';
const { guide } = Astro.props as { guide: Pick<Guide, 'path' | 'title'> };
---

<a
  class="guide-edit"
  data-guide-edit
  href={guideEditorHref(guide)}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={`Edit ${guide.title} in Guide Editor`}
>
  <Icon name="contribute" size={17} />
  <span class="guide-edit-label">Edit page in Guide Editor</span>
</a>
