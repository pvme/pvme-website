---
import type { Guide } from '../lib/catalogue';
import Icon from './Icon.astro';
import { guideEditorHref } from '../lib/guide-editor';
const { guide } = Astro.props as { guide: Pick<Guide, 'path' | 'title'> };
---

<div
  class="guide-actions"
  data-guide-actions
  data-guide-path={guide.path}
  data-guide-title={guide.title}
>
  <details class="guide-edit-menu">
    <summary aria-label="Edit page">
      <Icon name="contribute" size={16} />
      <span class="guide-action-label">Edit Page</span>
      <span class="guide-action-mobile-label">Edit</span>
      <span aria-hidden="true">▾</span>
    </summary>
    <div class="guide-edit-options">
      <button
        type="button"
        hidden={
          !import.meta.env.DEV &&
          (import.meta.env.PUBLIC_AUTHENTICATED_EDITING !== 'true' ||
            import.meta.env.PUBLIC_AUTHENTICATION !== 'true')
        }
        data-inline-edit-path={guide.path}
        data-inline-edit-title={guide.title}
      >
        Edit (in place)
      </button>
      <a
        data-guide-editor-external
        href={guideEditorHref(guide)}
        target="_blank"
        rel="noopener noreferrer"
      >
        Edit (in Guide Editor) <Icon name="external" size={14} />
      </a>
    </div>
  </details>
  <button
    type="button"
    class="guide-suggest"
    data-suggest-improvement
    aria-label="Suggest improvement"
    aria-haspopup="dialog"
    aria-controls="suggestion-dialog"
  >
    <Icon name="suggest" size={18} />
    <span class="guide-action-label">Suggest improvement</span>
    <span class="guide-action-mobile-label">Suggest</span>
  </button>
</div>
<script>
  document.addEventListener('click', (event) => {
    for (const menu of document.querySelectorAll<HTMLDetailsElement>(
      '.guide-edit-menu[open]',
    )) {
      const target = event.target as Element;
      if (
        !menu.contains(target) ||
        target.closest('.guide-edit-options button')
      )
        menu.open = false;
    }
  });
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    for (const menu of document.querySelectorAll<HTMLDetailsElement>(
      '.guide-edit-menu[open]',
    )) {
      menu.open = false;
      menu.querySelector<HTMLElement>('summary')?.focus();
    }
  });
</script>
