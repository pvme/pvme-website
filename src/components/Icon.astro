  search: 'M21 21l-6-6 M17 10a7 7 0 1 1-14 0 7 7 0 0 1 14 0',
  arrow: 'm9 4 8 8-8 8',
};
---

{styleFile ? (
  <img
    class="combat-style-icon"
    src={url(`/icons/styles/${styleFile}`)}
    width={size}
    height={size}
    alt=""
    aria-hidden="true"
  />
) : (
  <svg
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d={paths[name] || paths.general} />
  </svg>
)}
