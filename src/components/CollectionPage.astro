---
import DirectoryLayout from '../layouts/DirectoryLayout.astro';
import ResourceIcon from './ResourceIcon.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { url } from '../lib/catalogue';
import '../styles/resource-guides.css';
const { title, description, icon, parent, artwork } = Astro.props as {
  title: string;
  description: string;
  icon: string;
  parent: { label: string; href: string };
  artwork?: ImageMetadata;
};
const breadcrumbs = [
  ...(parent.href === '/' ? [] : [{ label: 'Home', href: '/' }]),
  parent,
  { label: title },
];
---

<DirectoryLayout
  title={title}
  description={description}
  activePath={parent.href}
  breadcrumbs={breadcrumbs}
  pageClass="resource-category-page collection-page"
  headingClass="resource-category-heading"
>
  <span slot="icon" class="resource-category-icon">
    {artwork ? (
      <Image
        class="collection-heading-art"
        src={artwork}
        width={192}
        format="webp"
        quality={85}
        alt=""
      />
    ) : (
      <ResourceIcon name={icon} size={52} />
    )}
  </span>
  <slot />
  <a class="resource-category-back" href={url(parent.href)}>
    ← Back to {parent.label}
  </a>
</DirectoryLayout>
