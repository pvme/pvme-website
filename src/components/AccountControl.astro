---
import '../styles/account.css';
import Button from './Button.astro';
---

<details
  class="account-control"
  data-account
  hidden={
    !import.meta.env.DEV && import.meta.env.PUBLIC_AUTHENTICATION !== 'true'
  }
>
  <Button
    as="summary"
    variant="ghost"
    class="account-pill"
    aria-label="Contributor account"
  >
    <img
      data-account-avatar
      hidden
      width="24"
      height="24"
      alt=""
      referrerpolicy="no-referrer"
    />
    <span data-account-name>Account</span>
  </Button>
  <div class="account-panel">
    <p data-account-status role="status">
      Checking session…
    </p>
    <button type="button" data-login="discord" hidden>
      Log in with Discord
    </button>
    <button type="button" data-login="github" hidden>
      Log in with GitHub
    </button>
    <button type="button" data-logout hidden>
      Log out
    </button>
    <p data-account-error role="alert"></p>
  </div>
</details>
