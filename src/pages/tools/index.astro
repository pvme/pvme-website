---
import DirectoryLayout from '../../layouts/DirectoryLayout.astro';
import ResourceGuideBrowser from '../../components/ResourceGuideBrowser.astro';
import { getCatalogue } from '../../lib/catalogue';
import { websiteCollections } from '../../lib/collections';
import '../../styles/resource-guides.css';
const collections = websiteCollections(getCatalogue()).filter(
  (collection) => collection.parent.href === '/tools/',
);
const entries = [
  ...new Map(
    collections
      .flatMap((collection) =>
        collection.members.map((member) => ({
          ...member,
          category: collection.title,
          subtitle: collection.title,
          terms: [member.terms, collection.title, collection.description]
            .join(' ')
            .toLowerCase(),
        })),
      )
      .map((member) => [member.id, member]),
  ).values(),
];
const categories = collections.flatMap((collection) =>
  collection.members.map((member) => ({
    id: member.id,
    title: member.title,
    description: member.subtitle || '',
    icon: member.icon || 'tools',
    href: member.href,
    guides: [],
    collectionId: collection.id,
  })),
);
---

<DirectoryLayout
  title="Tools"
  pageClass="tools-page"
  description="PvME tools, built by players for players"
>
  <ResourceGuideBrowser
    categories={categories}
    entries={entries}
    parentPath="/tools/"
    categoryTitle="Tools"
    entryLabel="tools"
  />
</DirectoryLayout>
