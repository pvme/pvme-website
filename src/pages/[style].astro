---
import CombatStyleDirectory from '../components/CombatStyleDirectory.astro';
import { getCatalogue } from '../lib/catalogue';
import { combatStyleNames } from '../lib/combat-styles';
import { combatStyleDirectories } from '../lib/combat-style-directory';
export function getStaticPaths() {
  return combatStyleNames.map((style) => ({
    params: { style: style.toLowerCase() },
    props: { style },
  }));
}
const { style } = Astro.props;
const catalogue = getCatalogue();
const directories = combatStyleDirectories(
  catalogue.guides,
  [...catalogue.bosses, ...catalogue.slayer],
  catalogue.root,
).filter((directory) => directory.style === style);
---

<CombatStyleDirectory directories={directories} selectedStyle={style} />
