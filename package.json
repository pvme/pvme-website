{
  "name": "pvme-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "catalogue"
  ],
  "scripts": {
    "dev": "astro dev --host localhost --port 4321",
    "build": "astro check && astro build",
    "preview": "astro preview --host 127.0.0.1",
    "test": "tsx --test tests/*.test.ts",
    "verify": "npm run build && npm test && npm run catalogue:test",
    "format": "prettier --write src tests astro.config.mjs package.json tsconfig.json README.md",
    "previews:prepare": "tsx scripts/prepare-previews.ts",
    "catalogue": "tsx scripts/prepare-catalogue.ts",
    "catalogue:dev": "tsx scripts/prepare-catalogue.ts --inspect",
    "catalogue:test": "npm test --workspace=pvme-guide-catalogue",
    "prebuild": "npm run catalogue && npm run previews:prepare",
    "predev": "npm run catalogue && npm run previews:prepare",
    "discord:refresh": "tsx scripts/refresh-discord-channels.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@pvme/guide-parser": "^0.5.0",
    "ajv": "^8.20.0",
    "astro": "^7.4.12",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/node": "^22.0.0",
    "linkedom": "^0.18.15",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
